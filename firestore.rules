rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isDeveloper() {
      return isVerifiedUser()
        && request.auth.uid in [
          'ETPtQC0VA2NiSnX67rS2P2ma2tC2',
          'gOcPqOuyPJRWisE4dxvFkGTOl5g2'
        ];
    }

    // Keep these UIDs in sync with leaderboard-blacklist.js.
    function isLeaderboardBlacklisted(userId) {
      return userId in [
        'sIoLtlm9kubExe2BY5cVvIlOqKA3',
        '1MPm8Ra9VYQusZkCBpRCRDo7nJq2',
        'AtXSxyWxB0XTLVoB38EP9lXYY143',
        'FhAoaY0rbGeuHaDdpxeAOUxj7Tz2',
        'HqV0msSXj4MfRMxrZm5lcHijXSM2',
        'L5Hq0ozcQobIMUs2PySv2lHt4eQ2',
        'USfUIeFsBDbInpSqzuf9hF3ERSa2',
        'Xv8ZMsmMKUZ29AfF8NlDuoc9nXR2',
        'ef4NrLvi5mRWwNIAf9To9T2fxfH2',
        'jkF9e0C2IlhuzcPR7kNfymLH9yu2',
        'jsu9p9Yr2WVZxOlKn8QV1oPOQ972',
        'pDjQ4iYMC7cwP6fIcCM70HhngR63',
        'pQQ53hnSQpU45QbYO0uaU5VAlRm1',
        'vhprPM4Hdghiz1Rpx3t2BX9bmap2'
      ];
    }

    function isRngNextRollMutation(mutation) {
      return mutation in [
        "base",
        "melanistic",
        "albino",
        "piebald",
        "shiny",
        "leucistic",
        "bioluminescent",
        "copper",
        "emerald",
        "golden",
        "frostbite",
        "spectral",
        "abyssal",
        "volcanic",
        "megatooth",
        "void",
        "cosmic",
        "apex",
        "primordial",
        "leviathan",
        "eventhorizon"
      ];
    }

    function isValidRngNextRollCommand() {
      return request.resource.data.keys().hasAll([
          "type",
          "commandId",
          "targetUid",
          "targetLabel",
          "sharkName",
          "mutation",
          "mutationName",
          "createdBy",
          "createdAtMs",
          "expiresAtMs",
          "updatedAt"
        ])
        && request.resource.data.type == "rngNextRoll"
        && request.resource.data.commandId is string
        && request.resource.data.commandId.size() > 0
        && request.resource.data.commandId.size() <= 80
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetLabel is string
        && request.resource.data.targetLabel.size() <= 80
        && request.resource.data.sharkName is string
        && request.resource.data.sharkName.size() > 0
        && request.resource.data.sharkName.size() <= 120
        && request.resource.data.mutation is string
        && isRngNextRollMutation(request.resource.data.mutation)
        && request.resource.data.mutationName is string
        && request.resource.data.mutationName.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.resource.data.createdAtMs;
    }

    function isValidIndexThemeConfig() {
      return request.resource.data.keys().hasAll([
          "themeId",
          "themeName",
          "enabled",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.themeId in [
          "default",
          "summer",
          "birthday",
          "christmas",
          "halloween"
        ]
        && request.resource.data.themeName is string
        && request.resource.data.themeName.size() > 0
        && request.resource.data.themeName.size() <= 80
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidGlobalMessageConfig() {
      return request.resource.data.keys().hasOnly([
          "enabled",
          "message",
          "type",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 220
        && request.resource.data.type in ["info", "event", "warning"]
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidXpEventConfig() {
      return request.resource.data.keys().hasOnly([
          "id",
          "label",
          "multiplier",
          "enabled",
          "startMs",
          "endMs",
          "startedBy",
          "stoppedBy",
          "updatedAt"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.endMs is int
        && request.resource.data.updatedAt is int
        && (
          request.resource.data.enabled == false
          || (
            request.resource.data.id is string
            && request.resource.data.id.size() > 0
            && request.resource.data.id.size() <= 80
            && request.resource.data.label is string
            && request.resource.data.label.size() > 0
            && request.resource.data.label.size() <= 80
            && request.resource.data.multiplier is number
            && request.resource.data.multiplier >= 1
            && request.resource.data.multiplier <= 5
            && request.resource.data.startMs is int
            && request.resource.data.endMs > request.resource.data.startMs
            && request.resource.data.startedBy == request.auth.uid
          )
        );
    }

    function isValidLeaderboardWinner() {
      return request.resource.data.keys().hasOnly([
          "id",
          "rangeType",
          "periodKey",
          "periodLabel",
          "uid",
          "displayName",
          "profilePicture",
          "metricValue",
          "rewardName",
          "rewardImagePath",
          "endedAtMs",
          "createdBy"
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 80
        && request.resource.data.rangeType in ["daily", "monthly"]
        && request.resource.data.periodKey is string
        && request.resource.data.periodKey.size() > 0
        && request.resource.data.periodKey.size() <= 16
        && request.resource.data.periodLabel is string
        && request.resource.data.periodLabel.size() <= 40
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.profilePicture is string
        && request.resource.data.profilePicture.size() <= 180
        && request.resource.data.metricValue is number
        && request.resource.data.metricValue >= 0
        && request.resource.data.rewardName is string
        && request.resource.data.rewardName.size() <= 80
        && request.resource.data.rewardImagePath is string
        && request.resource.data.rewardImagePath.size() <= 180
        && request.resource.data.endedAtMs is int
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isCommunityBossEvent(eventId) {
      return eventId in [
        "summer-megaladon-2026",
        "summer-cladoselache-2026",
        "halloween-helicoprion-2026",
        "christmas-stethacanthus-2026"
      ];
    }

    function communityBossContributionValue(eventId) {
      return eventId == "summer-megaladon-2026" ? 2 : 1;
    }

    // Purchases: only server-side code (Cloud Functions using Admin SDK) should create purchase records.
    // Clients are prevented from creating/updating/deleting purchases to avoid spoofing.
    match /purchases/{purchaseId} {
      allow read: if isVerifiedUser() && request.auth.uid == resource.data.userId;
      allow create: if false;
      allow update, delete: if false;
    }

    // Entitlements: server-only writes. Clients may read their own entitlements.
    match /entitlements/{userId} {
      allow read: if isVerifiedUser() && request.auth.uid == userId;
      allow create: if false;
      allow update, delete: if false;
    }

    // Users collection for friend system
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Daily game state; developers may read participation for admin insights.
    match /userDaily/{userId} {
      allow read: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
      allow write: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Observations are immutable and owned by the authenticated player. They are
    // signals only; the browser cannot write detector reports or punishments.
    match /fairPlayPlayers/{userId}/rounds/{roundId} {
      allow read: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
      allow create: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid', 'mode', 'pool', 'roundId', 'won', 'guesses', 'elapsedMs', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'mode', 'pool', 'roundId', 'won', 'guesses', 'elapsedMs', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.roundId == roundId
        && roundId.size() <= 150
        && request.resource.data.mode in ['daily', 'infinite']
        && request.resource.data.pool in ['sharks', 'rays', 'mixed']
        && (request.resource.data.mode != 'daily'
          || roundId.matches('daily-[0-9]{4}-[0-9]{2}-[0-9]{2}-' + request.resource.data.pool))
        && request.resource.data.won is bool
        && request.resource.data.guesses is int
        && request.resource.data.guesses >= 1
        && request.resource.data.guesses <= 12
        && (request.resource.data.elapsedMs == null
          || (request.resource.data.elapsedMs is int
            && request.resource.data.elapsedMs >= 0
            && request.resource.data.elapsedMs <= 86400000))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /fairPlayReports/{userId} {
      allow read: if isDeveloper();
      allow write: if false;
    }

    function hasRngLeaderboardFields(keys) {
      return keys.hasAny([
        'rngRolls', 'rngGlobalRolls', 'rngBestOneIn', 'rngBestTier', 'rngBestShark',
        'rngLevel', 'rngPrestigeLevel', 'rngCollectionCount', 'rngUpdatedAt'
      ]);
    }

    // Developer giveaway plans and atomic delivery receipts.
    match /adminRewardRuns/{runId} {
      allow read, create, update: if isDeveloper();
      allow delete: if false;
      match /recipients/{userId} {
        allow read, create: if isDeveloper();
        allow update, delete: if false;
      }
    }

    // User stats for leaderboard and friends system
    match /userStats/{userId} {
      allow read: if true;
      allow create: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper())
        && (isDeveloper() || !isLeaderboardBlacklisted(userId)
          || !hasRngLeaderboardFields(request.resource.data.keys()));
      allow update: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper())
        && (isDeveloper() || !isLeaderboardBlacklisted(userId)
          || !hasRngLeaderboardFields(request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());

      // One immutable claim per code, separate from replaceable profile snapshots.
      match /redeemedCodes/{codeId} {
        allow read: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
        allow create: if isVerifiedUser() && request.auth.uid == userId
          && codeId.matches('[A-Z0-9_-]{1,60}')
          && request.resource.data.keys().hasOnly(['uid', 'code', 'redeemedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.code == codeId
          && request.resource.data.redeemedAt == request.time;
        allow update, delete: if isDeveloper();
      }

      // One calendar win receipt per UTC day; clients cannot rewrite past receipts.
      match /christmasCalendarWins/{dayId} {
        allow read: if isVerifiedUser() && request.auth.uid == userId;
        allow create: if isVerifiedUser() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'day', 'mode', 'wonAt'])
          && request.resource.data.uid == userId
          && request.resource.data.day is int
          && request.resource.data.day >= 1 && request.resource.data.day <= 25
          && dayId == string(request.resource.data.day)
          && request.resource.data.mode in ['daily', 'infinite']
          && request.resource.data.wonAt == request.time
          && request.time >= timestamp.date(2026, 12, request.resource.data.day)
          && request.time < timestamp.date(2026, 12, request.resource.data.day) + duration.value(1, 'd')
          && get(/databases/$(database)/documents/globalConfig/christmasEvent).data.part == 2;
      }

      match /christmasCalendarClaims/{dayId} {
        allow read: if isVerifiedUser() && request.auth.uid == userId;
        allow create: if isVerifiedUser() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'day', 'claimedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.day is int
          && request.resource.data.day >= 1 && request.resource.data.day <= 25
          && dayId == string(request.resource.data.day)
          && request.resource.data.claimedAt == request.time
          && request.time >= timestamp.date(2026, 12, request.resource.data.day)
          && request.time < timestamp.date(2026, 12, 26)
          && exists(/databases/$(database)/documents/userStats/$(userId)/christmasCalendarWins/$(dayId))
          && get(/databases/$(database)/documents/globalConfig/christmasEvent).data.part == 2;
      }
    }

    // Full Sharkdle profile saves. Kept private and chunked separately from public leaderboard stats.
    match /sharkdleProfiles/{userId} {
      allow read, write: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());

      match /chunks/{chunkId} {
        allow read, write: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
      }
    }

    match /leaderboardWinners/{winnerId} {
      allow read: if true;
      allow create, update: if isVerifiedUser()
        && !isLeaderboardBlacklisted(request.auth.uid)
        && !isLeaderboardBlacklisted(request.resource.data.uid)
        && isValidLeaderboardWinner();
      allow delete: if isDeveloper();
    }

    // Full Shark RNG saves. Collection data is chunked under each player doc.
    match /rngProfiles/{userId} {
      allow read, delete: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
      allow create: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
      // Older clients cannot overwrite a save format they cannot read.
      allow update: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper())
        && (resource.data.get('schemaVersion', 1) < 2
          || request.resource.data.get('schemaVersion', 1) >= 2);

      match /chunks/{chunkId} {
        allow read, write: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
      }
    }

    // Guest tokens are random browser IDs. Telemetry is developer-readable only.
    match /visitorDaily/{dayId}/guests/{visitorId} {
      allow read: if isDeveloper();
      allow create, update: if request.auth == null
        && visitorId.matches('^[a-f0-9]{32}$')
        && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasAll(['visitedAt', 'path', 'activity'])
        && request.resource.data.keys().hasOnly(['visitedAt', 'path', 'activity'])
        && request.resource.data.visitedAt == request.time
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 120
        && request.resource.data.activity is string
        && request.resource.data.activity.size() <= 80;
    }

    // One signed-in visitor record per player per UTC day.
    // Players can write only their own record; visitor history is developer-only.
    match /visitorDaily/{dayId} {
      allow read, write: if false;

      match /users/{userId} {
        allow read: if isDeveloper();

        allow create: if isVerifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "visitedAt",
            "path"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 80
          && request.resource.data.visitedAt == request.time
          && request.resource.data.path is string
          && request.resource.data.path.size() <= 120;

        allow update: if isVerifiedUser()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "visitedAt",
            "path"
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "username",
            "visitedAt",
            "path"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 80
          && request.resource.data.visitedAt == request.time
          && request.resource.data.path is string
          && request.resource.data.path.size() <= 120;

        allow delete: if false;
      }
    }

    // Private per-species mistake tracker and deduplicated completed rounds
    match /userSpeciesStats/{userId} {
      allow read, create, update, delete: if isVerifiedUser() && request.auth.uid == userId;

      match /{document=**} {
        allow read, create, update, delete: if isVerifiedUser() && request.auth.uid == userId;
      }
    }

    // Separate Shark RNG leaderboard
    match /rngLeaderboard/{userId} {
      allow read: if true;
      allow create, update: if isVerifiedUser()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/userStats/$(userId))
        && request.resource.data.uid == userId
        && !isLeaderboardBlacklisted(userId);
      allow delete: if isVerifiedUser() && (request.auth.uid == userId || isDeveloper());
    }

    // Temporary global messages for big Shark RNG rolls
    match /rngBroadcasts/{broadcastId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly([
          "uid",
          "playerName",
          "speciesName",
          "tier",
          "mutation",
          "mutationName",
          "oneIn",
          "rollCount",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 32
        && request.resource.data.speciesName is string
        && request.resource.data.speciesName.size() > 0
        && request.resource.data.speciesName.size() <= 80
        && request.resource.data.tier in ["Ultra", "Hyper", "Omega", "Singularity", "Apex"]
        && request.resource.data.mutation is string
        && request.resource.data.mutation.size() <= 24
        && request.resource.data.mutationName is string
        && request.resource.data.mutationName.size() <= 32
        && request.resource.data.oneIn is int
        && request.resource.data.oneIn >= 2
        && (
          request.resource.data.oneIn >= 1000000
          || request.resource.data.tier == "Apex"
        )
        && request.resource.data.rollCount is int
        && request.resource.data.rollCount >= 1
        && request.resource.data.rollCount <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isDeveloper();
    }

    // Hidden one-time secret code reward
    match /rngSecretCodes/{codeId} {
      allow read: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && codeId == "comp_friend_1234"
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.code == "1234";

      allow update, delete: if isDeveloper();
    }

    // Global runtime config
    match /globalConfig/{configId} {
      allow read: if true;
      allow create, update: if isDeveloper()
        && (
          (configId == "indexTheme" && isValidIndexThemeConfig())
          || (configId == "globalMessage" && isValidGlobalMessageConfig())
          || (configId == "xpEvent" && isValidXpEventConfig())
          || (configId == "christmasEvent"
            && request.resource.data.keys().hasOnly(['part', 'updatedBy', 'updatedAt'])
            && request.resource.data.part in [1, 2]
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time)
          || isValidRngNextRollCommand()
        );
      allow delete: if isDeveloper();
    }

    // Community boss events
    match /communityEvents/{eventId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && isCommunityBossEvent(eventId)
        && request.resource.data.keys().hasOnly([
          "wins",
          "updatedAt",
          "lastContributionMode",
          "lastContributionUid"
        ])
        && request.resource.data.wins == communityBossContributionValue(eventId)
        && request.resource.data.lastContributionUid == request.auth.uid
        && request.resource.data.lastContributionMode in ["daily", "infinite"];

      allow update: if isVerifiedUser()
        && isCommunityBossEvent(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "wins",
          "updatedAt",
          "lastContributionMode",
          "lastContributionUid"
        ])
        && resource.data.wins < 150
        && request.resource.data.wins == resource.data.wins + communityBossContributionValue(eventId)
        && request.resource.data.lastContributionUid == request.auth.uid
        && request.resource.data.lastContributionMode in ["daily", "infinite"];

      allow delete: if isDeveloper();

      match /contributors/{userId} {
        allow read: if true;

        allow create: if isVerifiedUser()
          && isCommunityBossEvent(eventId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "profilePicture",
            "wins",
            "firstContributionAt",
            "updatedAt",
            "lastContributionMode"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.wins == communityBossContributionValue(eventId)
          && request.resource.data.lastContributionMode in ["daily", "infinite"];

        allow update: if isVerifiedUser()
          && isCommunityBossEvent(eventId)
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "wins",
            "username",
            "profilePicture",
            "updatedAt",
            "lastContributionMode"
          ])
          && resource.data.wins < 150
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.wins == resource.data.wins + communityBossContributionValue(eventId)
          && request.resource.data.lastContributionMode in ["daily", "infinite"];

        allow delete: if isDeveloper();
      }
    }

    // Friend network
    match /friendNetwork/{userId} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isVerifiedUser();
    }

    // Friend codes
    match /friendCodes/{code} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isVerifiedUser() && request.resource.data.uid == request.auth.uid;
    }

    // Duels
    match /duels/{duelId} {
      allow get: if isVerifiedUser() && request.auth.uid in resource.data.players;
      allow list: if isVerifiedUser() && request.auth.uid in resource.data.players;

      allow create: if isVerifiedUser()
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.shark is map
        && request.resource.data.guesses is map;

      allow update: if isVerifiedUser() && request.auth.uid in resource.data.players;
    }

    // Shark likes
    match /sharkLikes/{sharkId} {
      allow read: if true;
      allow create, update: if isVerifiedUser();
    }

    // Per-user shark likes
    match /userSharkLikes/{userId} {
      allow read: if isVerifiedUser() && request.auth.uid == userId;
      allow create, update, delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Battle arena
    match /battleArenaLobbies/{lobbyId} {
      allow read, create, update: if isVerifiedUser();
      allow delete: if isDeveloper();

      match /players/{playerId} {
        allow read: if isVerifiedUser();
        allow create, update, delete: if isVerifiedUser() && request.auth.uid == playerId;
      }

      match /events/{eventId} {
        allow read, create: if isVerifiedUser();
        allow update, delete: if isDeveloper();
      }
    }
  }
}

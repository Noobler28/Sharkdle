rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDeveloper() {
      return request.auth != null
        && request.auth.uid in [
          'ETPtQC0VA2NiSnX67rS2P2ma2tC2',
          'gOcPqOuyPJRWisE4dxvFkGTOl5g2'
        ];
    }

    function isRngNextRollMutation(mutation) {
      return mutation in [
        "base",
        "melanistic",
        "albino",
        "piebald",
        "shiny",
        "leucistic",
        "bioluminescent",
        "copper",
        "emerald",
        "golden",
        "frostbite",
        "spectral",
        "abyssal",
        "volcanic",
        "megatooth",
        "void",
        "cosmic",
        "apex",
        "primordial",
        "leviathan",
        "eventhorizon"
      ];
    }

    function isValidRngNextRollCommand() {
      return request.resource.data.keys().hasAll([
          "type",
          "commandId",
          "targetUid",
          "targetLabel",
          "sharkName",
          "mutation",
          "mutationName",
          "createdBy",
          "createdAtMs",
          "expiresAtMs",
          "updatedAt"
        ])
        && request.resource.data.type == "rngNextRoll"
        && request.resource.data.commandId is string
        && request.resource.data.commandId.size() > 0
        && request.resource.data.commandId.size() <= 80
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetLabel is string
        && request.resource.data.targetLabel.size() <= 80
        && request.resource.data.sharkName is string
        && request.resource.data.sharkName.size() > 0
        && request.resource.data.sharkName.size() <= 120
        && request.resource.data.mutation is string
        && isRngNextRollMutation(request.resource.data.mutation)
        && request.resource.data.mutationName is string
        && request.resource.data.mutationName.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.resource.data.createdAtMs;
    }

    function isValidIndexThemeConfig() {
      return request.resource.data.keys().hasAll([
          "themeId",
          "themeName",
          "enabled",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.themeId in [
          "default",
          "summer",
          "birthday",
          "christmas",
          "halloween"
        ]
        && request.resource.data.themeName is string
        && request.resource.data.themeName.size() > 0
        && request.resource.data.themeName.size() <= 80
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidGlobalMessageConfig() {
      return request.resource.data.keys().hasOnly([
          "enabled",
          "message",
          "type",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 220
        && request.resource.data.type in ["info", "event", "warning"]
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidXpEventConfig() {
      return request.resource.data.keys().hasOnly([
          "id",
          "label",
          "multiplier",
          "enabled",
          "startMs",
          "endMs",
          "startedBy",
          "stoppedBy",
          "updatedAt"
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.endMs is int
        && request.resource.data.updatedAt is int
        && (
          request.resource.data.enabled == false
          || (
            request.resource.data.id is string
            && request.resource.data.id.size() > 0
            && request.resource.data.id.size() <= 80
            && request.resource.data.label is string
            && request.resource.data.label.size() > 0
            && request.resource.data.label.size() <= 80
            && request.resource.data.multiplier is number
            && request.resource.data.multiplier >= 1
            && request.resource.data.multiplier <= 5
            && request.resource.data.startMs is int
            && request.resource.data.endMs > request.resource.data.startMs
            && request.resource.data.startedBy == request.auth.uid
          )
        );
    }

    function isValidLeaderboardWinner() {
      return request.resource.data.keys().hasOnly([
          "id",
          "rangeType",
          "periodKey",
          "periodLabel",
          "uid",
          "displayName",
          "profilePicture",
          "metricValue",
          "rewardName",
          "rewardImagePath",
          "endedAtMs",
          "createdBy"
        ])
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 80
        && request.resource.data.rangeType in ["daily", "monthly"]
        && request.resource.data.periodKey is string
        && request.resource.data.periodKey.size() > 0
        && request.resource.data.periodKey.size() <= 16
        && request.resource.data.periodLabel is string
        && request.resource.data.periodLabel.size() <= 40
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 128
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.profilePicture is string
        && request.resource.data.profilePicture.size() <= 180
        && request.resource.data.metricValue is number
        && request.resource.data.metricValue >= 0
        && request.resource.data.rewardName is string
        && request.resource.data.rewardName.size() <= 80
        && request.resource.data.rewardImagePath is string
        && request.resource.data.rewardImagePath.size() <= 180
        && request.resource.data.endedAtMs is int
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isCommunityBossEvent(eventId) {
      return eventId in [
        "summer-megaladon-2026",
        "summer-cladoselache-2026",
        "halloween-helicoprion-2026",
        "christmas-stethacanthus-2026"
      ];
    }

    function communityBossContributionValue(eventId) {
      return eventId == "summer-megaladon-2026" ? 2 : 1;
    }

    function isShiverMember(shiverId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/userShivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/userShivers/$(request.auth.uid)).data.shiverId == shiverId;
    }

    function isShiverLeader(shiverId) {
      return isShiverMember(shiverId)
        && exists(/databases/$(database)/documents/shivers/$(shiverId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/shivers/$(shiverId)/members/$(request.auth.uid)).data.role == "leader";
    }
    
    // Purchases: only server-side code (Cloud Functions using Admin SDK) should create purchase records.
    // Clients are prevented from creating/updating/deleting purchases to avoid spoofing.
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if false;
      allow update, delete: if false;
    }

    // Entitlements: server-only writes. Clients may read their own entitlements.
    match /entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
      allow update, delete: if false;
    }

    // Users collection for friend system
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Daily game state
    match /userDaily/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User stats for leaderboard and friends system
    match /userStats/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isDeveloper());
    }

    // Full Sharkdle profile saves. Kept private and chunked separately from public leaderboard stats.
    match /sharkdleProfiles/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isDeveloper());

      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isDeveloper());
      }
    }

    match /leaderboardWinners/{winnerId} {
      allow read: if true;
      allow create, update: if request.auth != null && isValidLeaderboardWinner();
      allow delete: if isDeveloper();
    }

    // Full Shark RNG saves. Collection data is chunked under each player doc.
    match /rngProfiles/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isDeveloper());

      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isDeveloper());
      }
    }

    // One signed-in visitor record per player per UTC day.
    // Players can write only their own record; visitor history is developer-only.
    match /visitorDaily/{dayId} {
      allow read, write: if false;

      match /users/{userId} {
        allow read: if isDeveloper();

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "visitedAt",
            "path"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 80
          && request.resource.data.visitedAt == request.time
          && request.resource.data.path is string
          && request.resource.data.path.size() <= 120;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "visitedAt",
            "path"
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "username",
            "visitedAt",
            "path"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 80
          && request.resource.data.visitedAt == request.time
          && request.resource.data.path is string
          && request.resource.data.path.size() <= 120;

        allow delete: if false;
      }
    }

    // Private per-species mistake tracker and deduplicated completed rounds
    match /userSpeciesStats/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Separate Shark RNG leaderboard
    match /rngLeaderboard/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Temporary global messages for big Shark RNG rolls
    match /rngBroadcasts/{broadcastId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "uid",
          "playerName",
          "speciesName",
          "tier",
          "mutation",
          "mutationName",
          "oneIn",
          "rollCount",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 32
        && request.resource.data.speciesName is string
        && request.resource.data.speciesName.size() > 0
        && request.resource.data.speciesName.size() <= 80
        && request.resource.data.tier in ["Ultra", "Hyper", "Omega", "Singularity", "Apex"]
        && request.resource.data.mutation is string
        && request.resource.data.mutation.size() <= 24
        && request.resource.data.mutationName is string
        && request.resource.data.mutationName.size() <= 32
        && request.resource.data.oneIn is int
        && request.resource.data.oneIn >= 2
        && (
          request.resource.data.oneIn >= 1000000
          || request.resource.data.tier == "Apex"
        )
        && request.resource.data.rollCount is int
        && request.resource.data.rollCount >= 1
        && request.resource.data.rollCount <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isDeveloper();
    }

    // Hidden one-time secret code reward
    match /rngSecretCodes/{codeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && codeId == "comp_friend_1234"
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.code == "1234";

      allow update, delete: if isDeveloper();
    }

    // Global runtime config
    match /globalConfig/{configId} {
      allow read: if true;
      allow create, update: if isDeveloper()
        && (
          (configId == "indexTheme" && isValidIndexThemeConfig())
          || (configId == "globalMessage" && isValidGlobalMessageConfig())
          || (configId == "xpEvent" && isValidXpEventConfig())
          || isValidRngNextRollCommand()
        );
      allow delete: if isDeveloper();
    }

    // Community boss events
    match /communityEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && isCommunityBossEvent(eventId)
        && request.resource.data.keys().hasOnly([
          "wins",
          "updatedAt",
          "lastContributionMode",
          "lastContributionUid"
        ])
        && request.resource.data.wins == communityBossContributionValue(eventId)
        && request.resource.data.lastContributionUid == request.auth.uid
        && request.resource.data.lastContributionMode in ["daily", "infinite"];

      allow update: if request.auth != null
        && isCommunityBossEvent(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "wins",
          "updatedAt",
          "lastContributionMode",
          "lastContributionUid"
        ])
        && resource.data.wins < 150
        && request.resource.data.wins == resource.data.wins + communityBossContributionValue(eventId)
        && request.resource.data.lastContributionUid == request.auth.uid
        && request.resource.data.lastContributionMode in ["daily", "infinite"];

      allow delete: if isDeveloper();

      match /contributors/{userId} {
        allow read: if true;

        allow create: if request.auth != null
          && isCommunityBossEvent(eventId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "profilePicture",
            "wins",
            "firstContributionAt",
            "updatedAt",
            "lastContributionMode"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.wins == communityBossContributionValue(eventId)
          && request.resource.data.lastContributionMode in ["daily", "infinite"];

        allow update: if request.auth != null
          && isCommunityBossEvent(eventId)
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "wins",
            "username",
            "profilePicture",
            "updatedAt",
            "lastContributionMode"
          ])
          && resource.data.wins < 150
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.wins == resource.data.wins + communityBossContributionValue(eventId)
          && request.resource.data.lastContributionMode in ["daily", "infinite"];

        allow delete: if isDeveloper();
      }
    }

    // Shivers: Sharkdle clans/guilds.
    match /shivers/{shiverId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "id",
          "name",
          "nameLower",
          "tag",
          "tagUpper",
          "description",
          "color",
          "ownerUid",
          "ownerName",
          "status",
          "visibility",
          "memberCount",
          "maxMembers",
          "totalPoints",
          "seasonPoints",
          "battlePoints",
          "wins",
          "dailyWins",
          "infiniteWins",
          "dailyPoints",
          "infinitePoints",
          "seasonId",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.visibility in ["open", "closed"]
        && request.resource.data.memberCount == 1
        && request.resource.data.maxMembers <= 25
        && request.resource.data.totalPoints == 0
        && request.resource.data.seasonPoints == 0
        && request.resource.data.battlePoints == 0
        && request.resource.data.wins == 0
        && request.resource.data.dailyWins == 0
        && request.resource.data.infiniteWins == 0
        && request.resource.data.dailyPoints == 0
        && request.resource.data.infinitePoints == 0;

      allow update: if isDeveloper()
        || (
          isShiverMember(shiverId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "memberCount",
            "totalPoints",
            "seasonPoints",
            "battlePoints",
            "wins",
            "dailyWins",
            "infiniteWins",
            "dailyPoints",
            "infinitePoints",
            "seasonId",
            "updatedAt",
            "lastContributionAt",
            "lastContributionMode",
            "lastContributionUid"
          ])
        )
        || (
          isShiverLeader(shiverId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "visibility",
            "memberCount",
            "updatedAt"
          ])
        );

      allow delete: if isDeveloper();

      match /members/{userId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "profilePicture",
            "role",
            "shiverId",
            "shiverName",
            "shiverTag",
            "shiverColor",
            "points",
            "wins",
            "dailyWins",
            "infiniteWins",
            "joinedAt",
            "updatedAt"
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.shiverId == shiverId
          && request.resource.data.role in ["leader", "member"]
          && request.resource.data.points == 0
          && request.resource.data.wins == 0
          && request.resource.data.dailyWins == 0
          && request.resource.data.infiniteWins == 0;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "username",
            "profilePicture",
            "points",
            "wins",
            "dailyWins",
            "infiniteWins",
            "updatedAt",
            "lastContributionMode"
          ]);

        allow delete: if request.auth != null && request.auth.uid == userId || isDeveloper();
      }
    }

    match /userShivers/{userId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "uid",
          "username",
          "profilePicture",
          "role",
          "shiverId",
          "shiverName",
          "shiverTag",
          "shiverColor",
          "points",
          "wins",
          "dailyWins",
          "infiniteWins",
          "joinedAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["leader", "member"]
        && request.resource.data.points == 0
        && request.resource.data.wins == 0
        && request.resource.data.dailyWins == 0
        && request.resource.data.infiniteWins == 0;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.shiverId == resource.data.shiverId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "username",
          "profilePicture",
          "shiverName",
          "shiverTag",
          "shiverColor",
          "points",
          "wins",
          "dailyWins",
          "infiniteWins",
          "updatedAt",
          "lastContributionMode"
        ]);

      allow delete: if request.auth != null && request.auth.uid == userId || isDeveloper();
    }

    match /shiverSeasons/{seasonId} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();

      match /entries/{shiverId} {
        allow read: if true;

        allow create: if isShiverMember(shiverId)
          && request.resource.data.keys().hasOnly([
            "shiverId",
            "name",
            "tag",
            "color",
            "memberCount",
            "points",
            "wins",
            "dailyWins",
            "infiniteWins",
            "seasonId",
            "updatedAt",
            "lastContributionMode",
            "lastContributionUid"
          ])
          && request.resource.data.shiverId == shiverId
          && request.resource.data.seasonId == seasonId
          && request.resource.data.lastContributionUid == request.auth.uid;

        allow update: if isShiverMember(shiverId)
          && request.resource.data.shiverId == resource.data.shiverId
          && request.resource.data.seasonId == resource.data.seasonId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "tag",
            "color",
            "memberCount",
            "points",
            "wins",
            "dailyWins",
            "infiniteWins",
            "updatedAt",
            "lastContributionMode",
            "lastContributionUid"
          ])
          && request.resource.data.lastContributionUid == request.auth.uid;

        allow delete: if isDeveloper();

        match /members/{userId} {
          allow read: if true;

          allow create, update: if request.auth != null
            && request.auth.uid == userId
            && isShiverMember(shiverId)
            && request.resource.data.keys().hasOnly([
              "uid",
              "username",
              "profilePicture",
              "points",
              "wins",
              "dailyWins",
              "infiniteWins",
              "updatedAt",
              "lastContributionMode"
            ])
            && request.resource.data.uid == request.auth.uid;

          allow delete: if isDeveloper();
        }
      }
    }

    // Friend network
    match /friendNetwork/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Friend codes
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Duels
    match /duels/{duelId} {
      allow get: if request.auth != null && request.auth.uid in resource.data.players;
      allow list: if request.auth != null && request.auth.uid in resource.data.players;

      allow create: if request.auth != null
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.shark is map
        && request.resource.data.guesses is map;

      allow update: if request.auth != null && request.auth.uid in resource.data.players;
    }

    // Shark likes
    match /sharkLikes/{sharkId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Per-user shark likes
    match /userSharkLikes/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Battle arena
    match /battleArenaLobbies/{lobbyId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isDeveloper();

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == playerId;
      }

      match /events/{eventId} {
        allow read, create: if request.auth != null;
        allow update, delete: if isDeveloper();
      }
    }
  }
}
